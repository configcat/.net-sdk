<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(CITargetFramework)' != ''">$(CITargetFramework)</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <PublishAot>true</PublishAot>

    <FrameworkLibVersion>10.0.15</FrameworkLibVersion>
    <FrameworkLibVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</FrameworkLibVersion>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(FrameworkLibVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(FrameworkLibVersion)" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\src\ConfigCat.Extensions.Hosting\ConfigCat.Extensions.Hosting.csproj" />
    <!-- Use PackageReference instead of the ProjectReference above in your application. -->
    <!--<PackageReference Include="ConfigCat.Extensions.Hosting" Version="*" />-->
  </ItemGroup>

</Project>
